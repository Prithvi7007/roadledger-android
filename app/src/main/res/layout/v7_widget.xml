<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/v7_widget_body"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="18dp"
    android:background="#17263A"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ROADLEDGER" android:textSize="12sp" android:textColor="#8BFFDC"
        android:textStyle="bold" />
    <TextView android:id="@+id/v7_widget_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="My vehicle" android:textSize="18sp" android:textColor="#FFFFFF" android:textStyle="bold"
        android:layout_marginTop="9dp" />
    <TextView android:id="@+id/v7_widget_odo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="0 km" android:textSize="24sp" android:textColor="#FFFFFF" android:textStyle="bold"
        android:layout_marginTop="6dp" />
    <TextView android:id="@+id/v7_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Service due: 0" android:textSize="12sp" android:textColor="#CBDAED" android:layout_marginTop="5dp" />
</LinearLayout>
